# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://clinexpro.net

# Postgres connection string. Required in production (see DEPLOY.md).
# Leave unset locally to use the dev database from `npm run db`.
# DATABASE_URL=postgres://user:password@host:5432/clinexpro

# Signs admin session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# First admin account, created by `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Alerts (optional; unset = logged to the console) -------------------
# Email via Resend (resend.com). Domain must be verified there.
# RESEND_API_KEY=
# EMAIL_FROM=Clinex Pro <bookings@clinexpro.net>
# TEAM_EMAIL=info@clinexpro.net

# WhatsApp Cloud API (Meta). Templates are listed in DEPLOY.md.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TEAM_WHATSAPP=23055047906
# WHATSAPP_TEMPLATE_TEAM=new_request_alert
# WHATSAPP_TEMPLATE_CUSTOMER=booking_received

# --- Online deposits -----------------------------------------------------
# none (default) | test (simulated gateway; refused in production unless
# PAYMENT_ALLOW_TEST=1, for staging only).
# PAYMENT_PROVIDER=none

# --- Invoices --------------------------------------------------------------
# VAT: leave unset (0) unless Clinex Pro is VAT-registered; 15 = Mauritius
# standard rate. Prices are treated as VAT-inclusive.
# VAT_RATE_PERCENT=15
# VAT_NUMBER=
# BUSINESS_BRN=
# INVOICE_DUE_DAYS=7
# Printed on unpaid invoices; use 
 for new lines.
# INVOICE_PAYMENT_INSTRUCTIONS="MCB account 000-000000-000 (Clinex Pro Contracting Ltd)
Juice: 5504 7906"

# --- Marketing measurement (optional; see DEPLOY.md) -----------------------
# Set ONE of these. Nothing loads, and no consent banner shows, until one is set.
# Google Tag Manager container (recommended: GA4 + Google Ads + Meta in one place)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# ...or Google Analytics 4 directly
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
